# Placement Prep Agent — Environment Variables
# Copy this file to .env and fill in your values

# Mistral API Key (get from https://console.mistral.ai)
XAI_API_KEY=your_mistral_api_key_here

# LLM Model (options: mistral-large-latest, open-mixtral-8x22b)
LLM_MODEL=mistral-large-latest

# API Base URL (do not change unless using a different provider)
LLM_BASE_URL=https://api.mistral.ai/v1

# Database path (relative to project root)
DB_PATH=data/sessions.db

# Set to "true" to use mock LLM responses (for development/testing)
MOCK_MODE=false
